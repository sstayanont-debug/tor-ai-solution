# คัดลอกไฟล์นี้เป็น .env แล้วใส่ API key ของคุณ
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (ไม่บังคับ) เปลี่ยนโมเดลที่ใช้ ค่าเริ่มต้นคือ claude-sonnet-5
# TOR_AI_MODEL=claude-sonnet-5

# บัญชีผู้ดูแลระบบ (admin) เริ่มต้น — ระบบจะสร้างให้อัตโนมัติเฉพาะตอนที่ยังไม่มี user ใดในระบบเลย
# ควรเปลี่ยนค่าเหล่านี้ก่อน deploy จริง แล้วเข้าสู่ระบบครั้งแรกด้วยค่านี้ จากนั้นไปเปลี่ยนรหัสผ่านที่หน้า "จัดการผู้ใช้"
DEFAULT_ADMIN_EMAIL=admin@company.local
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# e-GP Market Intelligence (ไม่บังคับ) — ขอ API key ฟรีที่ https://opend.data.go.th/register_api
# EGP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
